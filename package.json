{
  "name": "wp-agent-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @wp-agent-studio/web --filter @wp-agent-studio/worker dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @wp-agent-studio/database generate",
    "db:migrate": "pnpm --filter @wp-agent-studio/database migrate",
    "db:seed": "pnpm --filter @wp-agent-studio/database seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "4.1.10"
  }
}

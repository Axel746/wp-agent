# Application et stockage
DATABASE_URL=postgresql://wpagent:wpagent@localhost:5432/wpagent
# Garder true par défaut. Mettre false uniquement si l’hébergeur PostgreSQL
# présente une chaîne de certificats non reconnue par le runtime Node.js.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
PG_BOSS_SCHEMA=pgboss
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
# 32 octets encodés en base64, par exemple: openssl rand -base64 32
ENCRYPTION_KEY=
ARTIFACTS_DIR=./artifacts

# Mode démonstration déterministe ou fournisseurs réels
AGENT_MODE=mock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
OPENAI_API_KEY=
CODEX_MODEL=
CODEX_HOME=

# Session locale de démonstration (à remplacer en production)
DEMO_ADMIN_EMAIL=admin@wp-agent.local
DEMO_ADMIN_PASSWORD=change-me

# WordPress local Docker
WORDPRESS_LOCAL_URL=http://localhost:8080
WORDPRESS_LOCAL_ADMIN_USER=wpagent
WORDPRESS_LOCAL_ADMIN_PASSWORD=change-me
WORDPRESS_LOCAL_ADMIN_EMAIL=admin@example.test

# Les actions distantes restent désactivées sans activation explicite
ENABLE_REMOTE_DEPLOYMENT=false
ENABLE_PRIVATE_NETWORK_TARGETS=false
LOG_LEVEL=info
MAX_AGENT_TURNS=12
MAX_FIX_CYCLES=2
AGENT_TIMEOUT_MS=120000
